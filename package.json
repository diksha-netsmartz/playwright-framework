{
  "name": "clientplaywrightframework",
  "version": "1.0.0",
  "description": "Playwright Automation Framework",
  "main": "index.js",
  "scripts": {
    "test:headless": "cross-env HEADLESS=true npx playwright test",
    "test:headed": "cross-env HEADLESS=false npx playwright test",
    "test:batch:headless": "cross-env HEADLESS=true npx playwright test --workers=1",
    "test:batch:headed": "cross-env HEADLESS=false npx playwright test --workers=1",
    "test:failed:headless": "cross-env HEADLESS=true npx playwright test --last-failed",
    "test:failed:headed": "cross-env HEADLESS=false npx playwright test --last-failed",
    "test:smoke": "cross-env HEADLESS=false npx playwright test --grep @smoke",
    "test:smoke:headless": "cross-env HEADLESS=true npx playwright test --grep @smoke",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "check": "tsc -p jsconfig.json --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "node scripts/open-latest-allure.js",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.3.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.15",
    "pdf-to-img": "^6.2.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
