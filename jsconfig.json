{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "fixtures/**/*.js",
    "pages/**/*.js",
    "tests/**/*.js",
    "utils/**/*.js",
    "config/**/*.js",
    "scripts/**/*.js",
    "playwright.config.js"
  ],
  "exclude": [
    "node_modules",
    "allure-report",
    "allure-reports",
    "allure-results",
    "playwright-report",
    "test-results",
    "screenshots"
  ]
}